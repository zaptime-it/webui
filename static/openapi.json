									}
								}
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "successful operation"
					},
					"400": {
						"description": "Missing parameter"
					}
				}
			}
		},
		"/api/frontlight/set": {
			"post": {
				"tags": ["frontlight"],
				"summary": "Set per-channel frontlight duties (manual override)",
				"description": "Body is a flat JSON array of 12-bit duty values (0..4095), one\nentry per panel-backlight channel. Length must equal `numScreens`\n(or be empty to clear all channels to 0). Bypasses the DND gate\nand the always-on / lux fader so a debug pattern (e.g. zebra)\npersists until any subsequent block-flash, ambient transition,\nor brightness PATCH resumes uniform fader control.\n",
				"security": [
					{
						"basicAuth": []
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "array",
								"items": {
									"type": "integer",
									"minimum": 0,
									"maximum": 4095
								}
							},
							"example": [2048, 0, 2048, 0, 2048, 0, 2048]
						}
					}
				},
				"responses": {
					"200": {
						"description": "successful operation"
					},
					"400": {
						"description": "bad json / channel count mismatch / out of range"
					},
					"503": {
						"description": "frontlight not present on this board"
					}
				}
			}
		},
		"/events": {
			"get": {
				"tags": ["system"],
				"summary": "Server-Sent Events stream of status updates",
				"description": "Event stream for live status updates. The firmware emits three\nkinds of frames over the wire:\n\n- `event: welcome` \u2014 sent once on connect; payload is the\n  stringified IP address of the client.\n- `event: status` \u2014 payload JSON matches `GET /api/status`\n  (shares `buildStatusJson()`). One frame is pushed on every\n  state change (block height update, screen rotation, LED\n  colour change, DND transition, etc.).\n- `data: closing` (no `event:` prefix, default `message`\n  listener) \u2014 sent immediately before the firmware closes the\n  connection cleanly (e.g. when the LFS image is being swapped\n  during an OTA finalisation). Clients should reconnect after\n  a short delay; this is a graceful handoff, not a failure.\n\nReconnect strategy: 1 s on first `error`, doubling to a 30 s\ncap (see `src/lib/api/sse.ts::computeBackoffMs` in the WebUI),\nand 5 s after a `closing` message. The \"lost connection\"\noverlay reads its label from `statusStore.otaInProgress` so\nusers see \"Updating firmware\u2026\" during an OTA reconnect.\n",
				"security": [
					{
						"basicAuth": []
					}
				],
				"responses": {
					"200": {
						"description": "text/event-stream"
					}
				}
			}
		},
		"/api/diag/heap_trace/start": {
			"post": {
				"tags": ["diag"],
				"summary": "Begin a leak-mode heap_trace window (dev builds only)",
				"description": "Routes through `heap_trace_init_standalone` +\n`heap_trace_start(HEAP_TRACE_LEAKS)`. Endpoint is compiled out\nunless the firmware is built with\n`CONFIG_HEAP_TRACING_STANDALONE=y` \u2014 currently only the Rev A\nbuild ships it. On builds without the option the route returns\n404.\n\nCalling `start` while a window is already armed will reset the\ncapture buffer. Optional JSON body `{ \"cap\": N }` chooses the\nrecord capacity (1..4096).\n",
				"security": [
					{
						"basicAuth": []
					}
				],
				"requestBody": {
					"required": false,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"cap": {
										"type": "integer",
										"minimum": 1,
										"maximum": 4096
									}
								}
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Trace started",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"started": {
											"type": "boolean",
											"example": true
										},
										"capacity": {
											"type": "integer",
											"description": "Number of leak-record slots in the trace buffer.",
											"example": 256
										},
										"depth": {
											"type": "integer",
											"description": "Per-record stack depth (`CONFIG_HEAP_TRACING_STACK_DEPTH`).",
											"example": 4
										}
									}
								}
							}
						}
					},
					"404": {
						"description": "Endpoint not compiled in (CONFIG_HEAP_TRACING_STANDALONE=n)"
					},
					"409": {
						"description": "Trace could not be started (heap_trace_start returned non-OK)"
					}
				}
			}
		},
		"/api/diag/heap_trace/stop": {
			"post": {
				"tags": ["diag"],
				"summary": "Stop the active heap_trace window and dump live leaks",
				"description": "Stops the trace and returns the still-live records as JSON. Each\nrecord is a single allocation that was not freed before this\ncall. Resolve `pcs[]` with\n`xtensa-esp32s3-elf-addr2line -e <build>/btclock_v4.elf -f -p`.\n\nSee `docs/diag/heap_trace_2026-05-04/` in the firmware repo for\nan example pair of dumps and a symbol-resolution sidecar.\n",
				"security": [
					{
						"basicAuth": []
					}
				],
				"responses": {
					"200": {
						"description": "Trace stopped, leak records returned",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"count": {
											"type": "integer",
											"description": "Number of leak records returned."
										},
										"capacity": {
											"type": "integer",
											"description": "Buffer capacity at the time of the trace."
										},
										"leaks": {
											"type": "array",
											"items": {
												"type": "object",
												"properties": {
													"sz": {
														"type": "integer",
														"description": "Allocation size in bytes"
													},
													"addr": {
														"type": "string",
														"description": "Heap address (hex string)"
													},
													"cc": {
														"type": "integer",
														"description": "ccount cycle counter at alloc time"
													},
													"pcs": {
														"type": "array",
														"items": {
															"type": "string",
															"description": "Program counter (hex string)"
														},
														"description": "Stack frames of the allocation, deepest first.\nLength up to `CONFIG_HEAP_TRACING_STACK_DEPTH`.\n"
													}
												}
											}
										}
									}
								}
							}
						}
					},
					"404": {
						"description": "Endpoint not compiled in (CONFIG_HEAP_TRACING_STANDALONE=n)"
					}
				}
			}
		}
	},
