						"in": "query",
						"name": "txPower",
						"required": true,
						"schema": {
							"type": "integer"
						},
						"description": "ESP32 `wifi_power_t` value (e.g. 78 for 19.5 dBm)."
					}
				],
				"responses": {
					"200": {
						"description": "Power applied",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"setTxPower": {
											"type": "string",
											"example": "ok"
										}
									}
								}
							}
						}
					},
					"400": {
						"description": "Missing or invalid txPower"
					}
				}
			}
		},
