						"or malformed JSON": null
					}
				}
			}
		},
		"/api/lights/color": {
			"post": {
				"tags": ["lights"],
				"summary": "Set all LEDs to one RGB hex color",
				"description": "POST body carries color as JSON: `{ \"c\": \"FFCC00\" }` or `{ \"c\": \"off\" }`.\nLegacy query/rewritten forms are still accepted for compatibility.\n",
				"security": [
					{
						"basicAuth": []
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["c"],
								"properties": {
									"c": {
										"type": "string",
										"example": "FFCC00"
									}
