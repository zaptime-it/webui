		"/api/lights/effect": {
			"post": {
				"tags": ["lights"],
				"summary": "Trigger a named LED effect",
				"description": "Queues a named effect onto the existing LED worker. Unknown JSON\nkeys are silently ignored so future fields (`color`, `count`,\n`duration_ms`, \u2026) can be added without breaking existing\nclients. DND, `disableLeds`, and the global suppressor still\ngate the effect inside the LED controller.\n",
				"security": [
					{
						"basicAuth": []
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["name"],
								"properties": {
									"name": {
										"type": "string",
										"description": "Lower-snake effect name. Maps internally to a\n`LedEffect` enum value.\n",
										"enum": [
											"blink",
											"blink_success",
											"blink_error",
											"rainbow",
											"breathe",
											"breathe_error",
											"zap",
											"identify",
											"heartbeat",
											false,
											"idle"
										]
									}
								},
								"example": {
									"name": "rainbow"
								}
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Effect queued",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"queued": {
											"type": "boolean",
											"example": true
										},
										"name": {
											"type": "string",
											"example": "rainbow"
										}
									}
								}
							}
						}
					},
					"400": {
						"description": "Malformed body, missing `name`, or unknown effect name.\nBody is `{ \"error\": \"unknown effect\" }` (or a similar\nsingle-string `error` field).\n"
					}
				}
			}
		},
