{
	"openapi": "3.2.0",
	"info": {
		"title": "BTClock API",
		"version": "4.0.0",
		"description": "BTClock HTTP API as implemented by the firmware `src/lib/net/webserver/` module.\nREST routes are under `/api/...`; SSE lives at `/events`; OTA uploads use `/upload/...`.\nThe embedded WebUI may rewrite `/api` to `/` for same-origin routing.\n\n## Validation errors\n\n`PATCH /api/settings` returns `400 Bad Request` with a JSON body\n`{ \"error\": \"<field>:<reason>\" }` when a value fails validation \u2014\nsee the response definition on that endpoint for the full\nvocabulary. The WebUI's `parseSettingsError` helper splits this\ninto `{ field, reason }` so the offending input can be highlighted\nand scrolled into view.\n\n## Auth\n\nWhen the device has `httpAuthEnabled = true`, *every* endpoint on this\nspec requires HTTP Basic auth, including the SSE stream and read-only\nstatus endpoints. When it is false (the factory default), no endpoint\nrequires auth. The auth contract is the same on all routes so it is\nonly called out explicitly here rather than duplicated per-path.\n"
	},
	"servers": [
		{
			"url": "/"
		}
	],
	"paths": {
		"/api/status": {
			"get": {
				"tags": ["system"],
				"summary": "Get current runtime status",
				"security": [
					{
						"basicAuth": []
					}
				],
				"responses": {
					"200": {
						"description": "successful operation",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Status"
								}
							}
						}
					},
					"401": {
						"description": "Authentication required"
					}
				}
			}
		},
		"/api/system_status": {
			"get": {
				"tags": ["system"],
				"summary": "Get memory, filesystem, and WiFi metrics",
				"security": [
					{
						"basicAuth": []
					}
				],
				"responses": {
					"200": {
						"description": "successful operation",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SystemStatus"
								}
							}
						}
					},
					"401": {
						"description": "Authentication required"
					}
				}
			}
		},
		"/api/settings": {
			"get": {
				"tags": ["settings"],
				"summary": "Get current settings",
				"description": "Returns the full settings document. Password fields are NEVER included in the response;\ninstead, `httpAuthPassSet` and `otaPassSet` booleans indicate whether one is currently stored.\n",
				"security": [
					{
						"basicAuth": []
					}
				],
				"responses": {
					"200": {
						"description": "successful operation",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Settings"
								}
							}
						}
					},
					"401": {
						"description": "Authentication required"
					}
				}
			},
			"patch": {
				"tags": ["settings"],
				"summary": "Apply partial settings update",
				"description": "Send a JSON object with only the keys to change. Updatable keys include all `Settings`\npreference fields, the `screens` array, `actCurrencies`, the nested `dnd` block,\n`timePerScreen` (minutes, stored as `timerSeconds`), `tzOffset` (minutes, stored as\n`gmtOffset` seconds), `txPower`, `dataSource`, etc.\n\nTo set a password, include `httpAuthPass` / `otaPass` as a non-empty string.\nTo clear a stored password, send an empty string. Omit the key entirely to leave\nthe stored value unchanged \u2014 this is what clients should do when they are\nround-tripping a full settings form.\n",
				"security": [
					{
						"basicAuth": []
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/SettingsPatch"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Settings accepted. Body is empty when no boot-only fields were\ntouched, otherwise `{ \"rebootRequired\": true }`.\n",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"rebootRequired": {
											"type": "boolean",
											"example": true
										}
									}
								}
							}
						}
					},
					"400": {
						"description": "Validation failed. The body carries a single `error` string of\nthe form `<field>:<reason>` (e.g. `fontName:unknown`,\n`timerSeconds:bad_type`, `screens:dup_id`) \u2014 or, for the\ninverted numeric out-of-range form, `range:<field>`. The\nWebUI's `parseSettingsError` helper splits the two halves so\nit can highlight the offending input.\n",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"required": ["error"],
									"properties": {
										"error": {
											"type": "string",
											"example": "fontName:unknown"
										}
									}
								}
							}
						}
					},
					"401": {
						"description": "Authentication required"
					}
				}
			}
		},
		"/api/wifi_set_tx_power": {
			"post": {
				"tags": ["network"],
				"summary": "Set WiFi TX power (dBm enum value)",
