		"/api/frontlight/brightness": {
			"post": {
				"tags": ["frontlight"],
				"summary": "Set frontlight brightness",
				"security": [
					{
						"basicAuth": []
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["b"],
								"properties": {
									"b": {
										"type": "integer",
										"minimum": 0,
