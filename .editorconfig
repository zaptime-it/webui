root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# Markdown's leading-space conventions are meaningful for nested lists
# and code fences; don't auto-trim them.
[*.md]
trim_trailing_whitespace = false

# Files that demand spaces by spec or upstream tooling.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{json,jsonc}]
indent_style = tab
indent_size = 4

[*.py]
indent_style = space
indent_size = 4
