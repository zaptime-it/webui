{
	"name": "btclock-webui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:report": "ANALYZE=1 vite build",
		"build:gz": "vite build && python3 gzip_build.py",
		"build:test": "vite build --config vite.config.test.ts",
		"serve:test": "vite build --config vite.config.test.ts && vite preview --config vite.config.test.ts --host 127.0.0.1 --port 4173 --strictPort",
		"preview": "vite preview",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"generate:settings-meta": "python3 scripts/generate-settings-meta.py && prettier --write src/lib/types/settings.generated.ts",
		"check:settings-meta": "python3 scripts/generate-settings-meta.py --out /tmp/btclock-webui-settings-check.ts && prettier --config .prettierrc --write /tmp/btclock-webui-settings-check.ts && diff -q src/lib/types/settings.generated.ts /tmp/btclock-webui-settings-check.ts",
		"openapi:json": "python3 -c \"import yaml, json; json.dump(yaml.safe_load(open('static/openapi.yml')), open('static/openapi.json','w'), indent='\\t')\"",
		"check": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest",
		"test:unit": "vitest",
		"test:integration": "playwright test",
		"test:screenshots": "playwright test -c playwright.screenshot.config.ts",
		"test:all": "prettier --write . && eslint . && pnpm test:integration && pnpm test:unit run",
		"doc:update-screenshots": "playwright test -c playwright.doc-screenshot.config.ts"
	},
	"dependencies": {
		"@fontsource/ubuntu": "^5.3.0",
		"@inlang/paraglide-js": "^2.23.0",
		"@lucide/svelte": "^1.28.0",
		"@noble/secp256k1": "^3.1.0",
		"msgpack-es": "^0.0.5",
		"nostr-tools": "^2.24.1",
		"svelte-dnd-action": "^0.9.76",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.1.2",
		"@types/swagger-ui": "^5.32.0",
		"daisyui": "^5.7.9",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.8.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"rollup-plugin-visualizer": "^7.0.1",
		"sharp": "^0.35.3",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"svelte-eslint-parser": "^1.8.0",
		"tailwindcss": "4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.2.0",
		"vitest": "^4.1.10"
	}
}
