{
	"name": "btclock-webui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.28.5",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:test": "vite build --config vite.config.test.ts",
		"serve:test": "vite build --config vite.config.test.ts && vite preview --config vite.config.test.ts --host 127.0.0.1 --port 4173 --strictPort",
		"preview": "vite preview",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"check": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"postinstall": "patch-package",
		"test": "vitest",
		"test:unit": "vitest",
		"test:integration": "playwright test",
		"test:screenshots": "playwright test -c playwright.screenshot.config.ts",
		"test:all": "prettier --write . && eslint . && pnpm test:integration && pnpm test:unit run",
		"doc:update-screenshots": "playwright test -c playwright.doc-screenshot.config.ts"
	},
	"dependencies": {
		"@fontsource/antonio": "^5.3.0",
		"@fontsource/ubuntu": "^5.3.0",
		"@inlang/paraglide-js": "^2.27.0",
		"@lucide/svelte": "^1.55.0",
		"@noble/secp256k1": "^3.2.0",
		"msgpack-es": "^0.0.5",
		"nostr-tools": "^2.25.2",
		"patch-package": "^8.0.1",
		"svelte-dnd-action": "^0.9.80",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^25.9.9",
		"@types/swagger-ui": "^5.32.0",
		"daisyui": "^5.7.47",
		"esbuild": "^0.28.2",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"jsdom": "^29.1.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"sharp": "^0.34.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.9.0",
		"tailwindcss": "4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4",
		"vitest": "^4.1.11"
	}
}
